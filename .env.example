TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional: generate text for one predicted field in parallel with each decision (up to one extra helper call
# per decision). Leave unset on rate-limited free tiers.
# JEV_TEXT_PREFETCH=1
